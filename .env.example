# NOTE: `./setup.sh` generates this file for you. This example documents every
# supported variable for manual / production setups.

# default (required)
JWT_SECRET=
ENCRYPTION_KEY=

# First-run admin setup token (required to complete http://api.localhost/setup).
# The single admin is created once via the /setup wizard, then the route locks.
SETUP_TOKEN=

# Optional headless admin seed — if BOTH are set, the admin is created at startup
# and the /setup wizard reports "already configured". Leave blank to use /setup.
# ADMIN_EMAIL=
# ADMIN_PASS=

# db uri (required) -- include credentials for authenticated MongoDB
# e.g. mongodb://USER:PASSWORD@localhost:27017/?authSource=admin
MONGODB_URI=

# cors: comma-separated allowed origins for system routes (empty = allow all)
ALLOWED_ORIGINS=

# rate limiting (requests per window per IP — increase for high-traffic deployments)
RATE_LIMIT_API_MAX=300    # general API: 300 req / minute
RATE_LIMIT_AUTH_MAX=30    # auth endpoints: 30 req / 15 min
RATE_LIMIT_ANON_MAX=10    # anonymous login: 10 req / 15 min

# email using resend
RESEND_API_KEY=

# email using nodemailer
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# email info
FROM_NAME=
APP_NAME=
FROM_EMAIL=
SUPPORT_EMAIL=
