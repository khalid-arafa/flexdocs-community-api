# NOTE: `./setup.sh` generates this file for you. This example documents every
# supported variable for manual / production setups.

# default (required)
JWT_SECRET=
ENCRYPTION_KEY=

# First-run admin setup token (required to complete http://api.localhost/setup).
# The single admin is created once via the /setup wizard, then the route locks.
SETUP_TOKEN=

# Optional headless admin seed — if BOTH are set, the admin is created at startup
# and the /setup wizard reports "already configured". Leave blank to use /setup.
# ADMIN_EMAIL=
# ADMIN_PASS=

# db uri (required) -- include credentials for authenticated MongoDB
# e.g. mongodb://USER:PASSWORD@localhost:27017/?authSource=admin
MONGODB_URI=

# cors: comma-separated allowed origins for system routes.
# A listed origin gets credentialed CORS (cookies work). "*" — and, outside
# production, leaving this empty — serves the API as a PUBLIC one instead:
# any origin may read it, but browsers will not send cookies, so the
# cookie-authenticated dashboard needs its origin listed here explicitly.
# On a server, include your dashboard origin, e.g. http://admin.example.com
ALLOWED_ORIGINS=

# Reject socket connections whose project token is not a registered credential
# of the project. OPT-IN: only the exact value "true" enforces; unset, empty,
# "false" or a typo all allow (and log a warning). REST already refuses such a
# token on every request, so enabling this makes the two consistent.
# It is opt-in because a socket handshake failure is invisible to clients
# (socket.io buffers the emit, so file uploads hang at 0% and realtime silently
# stops), and enforcing it by default once caused an outage on a site running
# with a token missing from its credential list.
# BEFORE enabling: grep the API logs for "not a registered credential" — each
# entry names the project, the hash presented, and the hashes stored, which is
# enough to reconcile the credential list first. Enable only once that is quiet.
# ENFORCE_SOCKET_PROJECT_CREDENTIAL=true

# dashboard URL used for the post-setup "Go to dashboard" link
# (defaults to the first ALLOWED_ORIGINS entry, else http://admin.localhost)
DASHBOARD_URL=

# Public base URL of THIS API, used to build password-reset / email-verification
# links. Set this in production (e.g. https://api.example.com) so links are NOT
# built from the (attacker-controllable) request Host header. When unset, the
# Host is trusted only if it matches an allowlisted origin, else a safe fallback.
PUBLIC_API_URL=

# How long to keep retrying MongoDB at STARTUP before giving up and exiting 1
# (exponential backoff, 1s→10s). Covers Mongo starting up alongside the API.
# Exiting is deliberate: the supervisor restarts us, whereas an API left alive
# but never listening is a silent outage nothing recovers from.
BOOT_DB_TIMEOUT_MS=60000

# Exit on an unhandled promise rejection instead of logging and continuing.
# Default false: Express 4 and Socket.IO do not forward rejected async handlers,
# so a client-triggerable rejection would become a remote crash switch. Turn it
# on once a deployment is known clean — an unhandled rejection is a bug signal.
EXIT_ON_UNHANDLED_REJECTION=false

# rate limiting (requests per window per IP — increase for high-traffic deployments)
RATE_LIMIT_API_MAX=300    # general API: 300 req / minute
RATE_LIMIT_AUTH_MAX=30    # auth endpoints: 30 req / 15 min
RATE_LIMIT_ANON_MAX=10    # anonymous login: 10 req / 15 min

# email using resend
RESEND_API_KEY=

# email using nodemailer
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# email info
FROM_NAME=
APP_NAME=
FROM_EMAIL=
SUPPORT_EMAIL=
